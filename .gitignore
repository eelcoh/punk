# Zig: the build, its cache and the packages it fetched (Roc among them).
zig-out
zig-pkg
.zig-cache
# Cargo builds of the hosts and the example apps.
target
# Built hosts and libraries (test/setup.sh puts them in platforms/*/targets).
*.a
*.o
# The tutorial, built by mdBook (docs/tutorial).
docs/tutorial/book
# Release archives (tools/release/package.sh).
dist
# ring, as on crates.io (platforms/server/hermit/vendor), has objects for Windows.
!platforms/server/hermit/vendor/ring/pregenerated/*.o
